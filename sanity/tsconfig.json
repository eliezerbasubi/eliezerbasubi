{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2021", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "types": ["sanity"],
    "allowJs": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "sanity.config.ts",
    "sanity.cli.ts",
    "src/schemaTypes/**/*",
    "plugins/**/*",
    "schemas/**/*"
  ]
}
