{
  "name": "eliezerbasubi-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --pretty --noEmit",
    "format": "prettier --write .",
    "lint": "eslint . --ext ts --ext tsx --ext js"
  },
  "dependencies": {
    "@portabletext/react": "^4.0.3",
    "@sanity/asset-utils": "^2.3.0",
    "@sanity/image-url": "^1.2.0",
    "@vercel/analytics": "^1.5.0",
    "clsx": "^2.1.1",
    "next": "15.5.9",
    "next-sanity": "^11.6.2",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-icons": "^4.3.1",
    "tailwind-merge": "^3.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^20",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "eslint": "^8",
    "eslint-config-next": "15.5.4",
    "husky": "^4.3.8",
    "lint-staged": "^10.5.4",
    "postcss": "^8",
    "prettier": "^3.5.3",
    "shiki": "^3.3.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm run type-check && npm run lint"
    }
  },
  "lint-staged": {
    "*.@(ts|tsx)": [
      "npm run lint",
      "npm run format",
      "git add ."
    ]
  },
  "resolutions": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1"
  }
}